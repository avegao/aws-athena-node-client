{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 120,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "always",
    "bracketSameLine": false,
    "bracketSpacing": false,
    "sortPackageJson": true,
    "sortImports": true,
    "ignorePatterns": [
        "**/coverage/**/*",
        "**/.aws-sam/**/*",
        "**/.output/**/*",
        "**/.build/**/*",
        "**/.serverless/**/*",
        "**/.vscode/**/*",
        "**/build/**/*",
        "**/node_modules/**/*"
    ]
}
